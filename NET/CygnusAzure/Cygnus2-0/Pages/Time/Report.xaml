<UserControl x:Class="Cygnus2_0.Pages.Time.Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <GroupBox Header="Reporte Tareas Descargadas">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="1" VerticalAlignment="Center"  HorizontalAlignment="Right"  >Descripción: </Label>
                <TextBox x:Name="txtPara" Text="{Binding Path=Descripcion, Mode=TwoWay}" TextWrapping="Wrap" Margin="10,10,10,10" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="1" VerticalAlignment="Center" />
                <Label  Grid.Column="5" Grid.Row="0" Grid.ColumnSpan="1" VerticalAlignment="Center"  HorizontalAlignment="Right"  >HU:</Label>
                <TextBox x:Name="txtCC" Text="{Binding Path=HU, Mode=TwoWay}" TextWrapping="Wrap" Margin="10,10,10,10" Grid.Column="6" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="1" VerticalAlignment="Center" />
                <Label x:Name="lblFechaDesde" Content="Desde:" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <DatePicker x:Name="dtFechaDesde" SelectedDate="{Binding Path=FechaDesde}" Margin="0,0,0,0" SelectedDateFormat="Long"/>
                </StackPanel>
                
                <Label x:Name="lblFechaHasta" Content="Hasta:" Grid.Column="5" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                
                <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="6" Grid.Row="1" Grid.ColumnSpan="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <DatePicker x:Name="dtFechaHasta" SelectedDate="{Binding Path=FechaHasta}" Margin="0,0,0,0" SelectedDateFormat="Long"/>
                </StackPanel>
                
                <GroupBox Header="Releases" Margin="10,10,10,10" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="10" Grid.RowSpan="7">
                    <Grid>
                        <DataGrid
                        x:Name="dataGridReleases" 
                        IsReadOnly="false" 
                        AllowDrop="False"                   
                        AutoGenerateColumns="False"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        CanUserDeleteRows="false"
                        CanUserAddRows="false"
                        CanUserReorderColumns="false"
                        CanUserSortColumns="True"
                            ClipboardCopyMode="IncludeHeader"
                        ItemsSource="{Binding Path=ListaTask, Mode=TwoWay }"
                                    GridLinesVisibility="All"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"                          
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                    >
                            <DataGrid.Columns>

                                <DataGridTextColumn 
                        Header="Fecha"
                        x:Name="Fecha"
                        IsReadOnly="True"  
                        Width="100" 
                        Binding="{Binding Path=FechaInicio, Mode=OneWay}"                        >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn 
                        Header="Ingeniero"
                        x:Name="Ingeniero"
                        IsReadOnly="True"  
                        Width="130" 
                        MaxWidth="130"
                        Binding="{Binding Path=Usuario, Mode=OneWay}" 
                        >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                        Header="Requerimiento"
                        x:Name="Requerimiento"
                        IsReadOnly="true"
                        MaxWidth="160"
                        Binding="{Binding Path=DescUs, Mode=TwoWay}" 
                                >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                        Header="Task"
                        x:Name="Task"
                        IsReadOnly="true"                
                        Binding="{Binding Path=Codigo, Mode=TwoWay}" 
                        >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                        Header="Tiempo"
                        x:Name="Tiempo"
                        IsReadOnly="true"
                        Binding="{Binding Path=Horas, Mode=TwoWay}" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                        Header="Observación"
                                x:Name="observacion"
                        IsReadOnly="true"
                        Binding="{Binding Path=Descripcion, Mode=TwoWay}" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <Button x:Name="btnBuscar" Content="Buscar"  VerticalAlignment="Center" Grid.Column="8" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Click="BtnGenerar_Click"/>
                <Button x:Name="btnLimpiar" Content="Limpiar"  VerticalAlignment="Center" Grid.Column="9" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Click="btnLimpiar_Click"/>
            </Grid>
            
        </GroupBox> 
    </Grid>
</UserControl>
