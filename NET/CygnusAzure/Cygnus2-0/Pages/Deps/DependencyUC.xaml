<UserControl x:Class="Cygnus2_0.Pages.Deps.DependencyUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cygnus2_0.Pages.Deps"
             xmlns:general="clr-namespace:Cygnus2_0.Pages.General"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBox x:Name="Texto" 
             Text="{Binding Path=Model.Objeto}" 
             TextWrapping="Wrap" 
             VerticalContentAlignment="Center" 
             CharacterCasing="Upper" 
             Grid.Row="0" 
             Grid.Column="0"
             Grid.ColumnSpan="4"
             Margin="0,5,10,0"
             VerticalAlignment="Center"
             Style="{StaticResource placeHolder}" Tag="Objeto a buscar" />

        <ComboBox x:Name="comboBox" 
      ItemsSource="{Binding Path=Model.ListaBD}" 
      SelectedItem="{Binding Path=Model.BdSeleccionada}"
      DisplayMemberPath="Displayname" VerticalAlignment="Center" Grid.Row="0" 
        Grid.Column="5"
        Grid.ColumnSpan="4"
        Margin="0,5,10,0" />
        <TextBlock DataContext="{Binding ElementName=comboBox,Path=SelectedItem}"
   VerticalAlignment="Center"
   Text="Selecciona la Instancia" 
   Style="{StaticResource ComboBoxSelectOverlay}"  Grid.Row="0" 
        Grid.Column="5"
        Grid.ColumnSpan="4" Margin="0,5,10,0"/>

        <GroupBox Header="Dependencias" Margin="10,10,10,10" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="10" Grid.RowSpan="8">
            <Grid>
                <DataGrid
                        x:Name="dataGridDep" 
                        IsReadOnly="false" 
                        AllowDrop="False"                   
                        AutoGenerateColumns="False"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        CanUserDeleteRows="false"
                        CanUserAddRows="false"
                        CanUserReorderColumns="false"
                        CanUserSortColumns="True"
                            ClipboardCopyMode="IncludeHeader"
                        ItemsSource="{Binding Path=Model.ListaDependencias, Mode=TwoWay }"
                                    GridLinesVisibility="All"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"                          
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                    >
                    <DataGrid.Columns>

                        <DataGridTextColumn 
                        Header="Origen"
                        x:Name="Origen"
                        IsReadOnly="True"  
                        MaxWidth="220"
                        Binding="{Binding Path=Origen, Mode=OneWay}"                        >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn 
                        Header="Objeto"
                        x:Name="Objeto"
                        IsReadOnly="True"  
                        Width="300"
                        Binding="{Binding Path=Objeto, Mode=OneWay}" 
                        >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                        Header="Tipo"
                        x:Name="Tipo"
                        IsReadOnly="true"
                        MaxWidth="150"
                        Binding="{Binding Path=Tipo, Mode=TwoWay}" 
                                >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                        Header="Impacto"
                        x:Name="Impacto"
                        IsReadOnly="true"  
                        MaxWidth="150"
                        Binding="{Binding Path=Impacto, Mode=TwoWay}" 
                        >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                        Header="Texto"
                        x:Name="idTexto"
                        IsReadOnly="true"
                        Binding="{Binding Path=Texto, Mode=TwoWay}" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Button x:Name="btnBuscar" Content="Buscar"  VerticalAlignment="Center" Grid.Column="8" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Command="{Binding Path=Process}"/>
        <Button x:Name="btnLimpiar" Content="Limpiar"  VerticalAlignment="Center" Grid.Column="9" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Command="{Binding Path=Clean}"/>
    </Grid>
</UserControl>
