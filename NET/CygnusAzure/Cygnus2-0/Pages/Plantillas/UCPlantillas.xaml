<UserControl x:Class="Cygnus2_0.Pages.Plantillas.UCPlantillas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cygnus2_0.Pages.Plantillas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ComboBox x:Name="comboBox" 
   ItemsSource="{Binding Path=Model.ListaPlantilla}" 
   SelectedItem="{Binding Path=Model.PlantillaSeleccionada}"
   DisplayMemberPath="Nombre" VerticalAlignment="Center" Grid.Row="0" 
     Grid.Column="0"
     Grid.ColumnSpan="4"
     Margin="0,5,10,0" />
        <TextBlock DataContext="{Binding ElementName=comboBox,Path=SelectedItem}"
VerticalAlignment="Center"
Text="Seleccione la plantilla" 
Style="{StaticResource ComboBoxSelectOverlay}"  Grid.Row="0" 
     Grid.Column="0"
     Grid.ColumnSpan="4" Margin="5,5,0,5"/>

        <GroupBox Header="Parámetros de la plantilla" Margin="10,10,10,10" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="10" Grid.RowSpan="8">
            <Grid>
                <DataGrid
                     x:Name="dataGridDep"
                     AutoGenerateColumns="False"
                    SelectionMode="Single"
                    CanUserDeleteRows="false"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                     ItemsSource="{Binding Path=Model.PlantillaSeleccionada.ListaDetalleIn}"
                 >
                    <DataGrid.Columns>

                        <DataGridTextColumn                  
                        IsReadOnly="True"
                        Header="Parámetro"
                            Width="200"
                        Binding="{Binding Path=Parametro}" />

                        <DataGridTextColumn
                        Header="Valor"
                            Width="300"
                        Binding="{Binding Path=Valor}" />

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Button x:Name="btnProcesar" Content="Procesar"  VerticalAlignment="Center" Grid.Column="8" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Command="{Binding Path=Process}"/>
        <Button x:Name="btnLimpiar" Content="Limpiar"  VerticalAlignment="Center" Grid.Column="9" Grid.Row="10" Margin="0,0,5,0" HorizontalAlignment="Center" Command="{Binding Path=Clean}"/>
    </Grid>
</UserControl>
